# ── Paladin System ────────────────────────────────────────────────────────────

# Mode: dummy (test generators) or production (real collectors)
PALADIN_MODE=dummy

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# ── PostgreSQL (cold archive) ─────────────────────────────────────────────────
POSTGRES_DSN=postgresql://paladin:paladin@localhost:5432/paladin_archive

# ── Ollama / LLM ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# Parallel incident-analysis workers (LLM calls never block ingestion)
LLM_WORKERS=2

# ── SearXNG ───────────────────────────────────────────────────────────────────
SEARXNG_URL=http://localhost:8080

# ── SAP Thresholds ────────────────────────────────────────────────────────────
SAP_SCORE_THRESHOLD=0.7
SAP_CORRELATION_WINDOW=60
# Office timezone (offset from UTC) and working hours for off-hours detection
SAP_UTC_OFFSET_HOURS=5
SAP_WORK_HOURS_START=6
SAP_WORK_HOURS_END=22

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8888
# PRODUCTION mode refuses to start while these hold default values.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_ADMIN_PASSWORD=change-me
DASHBOARD_SECRET=paladin-secret-change-me

# ── Response policy ───────────────────────────────────────────────────────────
# Human-in-the-Loop window. On timeout, actions up to FLAG run automatically;
# ISOLATE / BLOCK / BLOCK_IP / QUARANTINE_FILE always wait for explicit approval
# (unless Autonomous mode is switched on in the dashboard).
OPERATOR_TIMEOUT_SECONDS=60
AUTO_EXECUTE_ENABLED=true

# ── Forensic layer ────────────────────────────────────────────────────────────
FORENSIC_ENABLED=true
SEVERITY_PIPELINE_THRESHOLD=0.65
MAX_CONCURRENT_INVESTIGATIONS=1
# REQUIRES_APPROVAL MCP calls are auto-denied after this many seconds
FORENSIC_APPROVAL_TIMEOUT=60
# Canned SIFT results for the nromanoff demo case. Never enable in production.
FORENSIC_DEMO_FIXTURES=false

# ── Archive Policy ────────────────────────────────────────────────────────────
ARCHIVE_LOG_DAYS=30
ARCHIVE_COMMS_DAYS=90
ARCHIVE_INCIDENT_DAYS=180

# ── Dummy Generators ─────────────────────────────────────────────────────────
DUMMY_EMPLOYEE_COUNT=15
DUMMY_EVENTS_PER_MIN=10
DUMMY_ANOMALY_PROB=0.05

# ── Protected Accounts ────────────────────────────────────────────────────────
# Account names or employee UIDs (case-insensitive) that are never targeted by
# FLAG-or-higher actions automatically; e.g. add emp-010 to protect the CEO.
PROTECTED_ACCOUNTS=admin,root,SYSTEM,paladin-service

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
